# Compression and TLS libraries: each is searched on the system and built from
# third_party/ (cloned there on demand, see ThirdParty.cmake) when
#
#   - BUILD_<LIB> is ON, or
#   - BUILD_<LIB> is AUTO and no usable installation is found, or the
#     compiler is musl (the libraries of the host link glibc symbols).
#
# Sets the same variables the rest of the build used with the former
# Check*.cmake: ZLIB_*, BZIP2_*, LIBLZMA_*, BROTLI_*, OPENSSL_*, TLS_LIBRARIES.
include(${CMAKE_CURRENT_LIST_DIR}/FindZlib.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/FindBZip2.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/FindLZMA.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/FindBrotli.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BuildZlib.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BuildBZip2.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BuildLZMA.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BuildBrotli.cmake)
include(${CMAKE_CURRENT_LIST_DIR}/BuildLibreSSL.cmake)

foreach(_lib ZLIB BZIP2 LZMA BROTLI SSL)
  set(BUILD_${_lib} AUTO CACHE STRING "build ${_lib} from third_party/: ON always, AUTO when not found, OFF never")
  set_property(CACHE BUILD_${_lib} PROPERTY STRINGS ON OFF AUTO)
endforeach(_lib)

if(CMAKE_POSITION_INDEPENDENT_CODE OR BUILD_SHARED_LIBS)
  set(_pic ON)
else()
  set(_pic OFF)
endif()

# codec_wanted(<LIB> <USE-VAR> <OUT>): OUT is TRUE when <LIB> is to be built from third_party/ without looking for an installation
macro(codec_wanted LIB USE OUTVAR)
  if(NOT ${USE} OR "${BUILD_${LIB}}" STREQUAL "OFF")
    set(${OUTVAR} FALSE)
  elseif("${BUILD_${LIB}}" STREQUAL "ON" OR MUSL)
    set(${OUTVAR} TRUE)
  else()
    set(${OUTVAR} FALSE)
  endif()
endmacro(codec_wanted)

if(USE_ZLIB)
  codec_wanted(ZLIB USE_ZLIB _build)
  if(NOT _build)
    find_zlib()
    if(ZLIB_FOUND OR "${BUILD_ZLIB}" STREQUAL "OFF")
      set(_build FALSE)
    else()
      set(_build TRUE)
    endif()
  endif(NOT _build)
  if(_build)
    build_zlib(${_pic})
  endif()
endif(USE_ZLIB)

if(USE_BZIP)
  codec_wanted(BZIP2 USE_BZIP _build)
  if(NOT _build)
    find_bzip2()
    if(BZIP2_FOUND OR "${BUILD_BZIP2}" STREQUAL "OFF")
      set(_build FALSE)
    else()
      set(_build TRUE)
    endif()
  endif(NOT _build)
  if(_build)
    build_bzip2(${_pic})
  endif()
endif(USE_BZIP)

if(USE_LZMA)
  codec_wanted(LZMA USE_LZMA _build)
  if(NOT _build)
    find_lzma()
    if(LIBLZMA_FOUND OR "${BUILD_LZMA}" STREQUAL "OFF")
      set(_build FALSE)
    else()
      set(_build TRUE)
    endif()
  endif(NOT _build)
  if(_build)
    build_lzma(${_pic})
  endif()
endif(USE_LZMA)

if(USE_BROTLI)
  codec_wanted(BROTLI USE_BROTLI _build)
  if(NOT _build)
    find_brotli()
    if(BROTLI_FOUND OR "${BUILD_BROTLI}" STREQUAL "OFF")
      set(_build FALSE)
    else()
      set(_build TRUE)
    endif()
  endif(NOT _build)
  if(_build)
    build_brotli(${_pic})
  endif()
endif(USE_BROTLI)

if(USE_SSL)
  codec_wanted(SSL USE_SSL _build)
  if(_build)
    build_libressl(${_pic})
  else()
    include(${CMAKE_CURRENT_LIST_DIR}/CheckOpenSSL.cmake)
    if(NOT OPENSSL_FOUND AND NOT "${BUILD_SSL}" STREQUAL "OFF")
      build_libressl(${_pic})
    endif()
  endif()
endif(USE_SSL)
