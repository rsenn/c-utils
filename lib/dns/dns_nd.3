.TH DNS_ND 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
dns_name4_domain \- Convert an IPv4 address to a DNS domain name

.SH SYNOPSIS
.IB #include <lib/dns.h>

.IB void
.IB dns_name4_domain(char name[DNS_NAME4_DOMAIN], const char ip[4]);

.SH DESCRIPTION
The \fBdns_name4_domain\fR function converts an IPv4 address to a DNS domain name in the reverse domain name notation (in-addr.arpa).

.SH ARGUMENTS
.IB name
A buffer of size DNS_NAME4_DOMAIN to store the resulting DNS domain name.

.IB ip
A pointer to a 4-byte array representing the IPv4 address.

.SH EXAMPLES
The following example demonstrates how to use the \fBdns_name4_domain\fR function:

.nf
#include <stdio.h>
#include <lib/dns.h>
#include <lib/stralloc.h>

int main() {
    char name[DNS_NAME4_DOMAIN];
    const char* ip = "192.168.1.1";

    dns_name4_domain(name, ip);
    printf("DNS domain name: %s\n", name);

    return 0;
}
.nef