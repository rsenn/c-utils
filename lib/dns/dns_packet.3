.TH DNS_PACKET 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
dns_packet_copy, dns_packet_skipname, dns_packet_getname \- Operations on DNS packets

.SH SYNOPSIS
.IB #include <lib/dns.h>

.IB unsigned int
.IB dns_packet_copy(const char* buf, unsigned int len, unsigned int pos, char* out, unsigned int outlen);

.IB unsigned int
.IB dns_packet_skipname(const char* buf, unsigned int len, unsigned int pos);

.IB unsigned int
.IB dns_packet_getname(const char* buf, unsigned int len, unsigned int pos, char** d);

.SH DESCRIPTION
These functions provide a set of operations for manipulating DNS packets.

.TP
.IB dns_packet_copy
Copies data from a DNS packet buffer to an output buffer.

.TP
.IB dns_packet_skipname
Skips the domain name at the current position in a DNS packet buffer.

.TP
.IB dns_packet_getname
Retrieves the domain name at the current position in a DNS packet buffer and stores it in an output buffer.

.SH EXAMPLES
The following example demonstrates how to use the \fBdns_packet_copy\fR function:

.nf
#include <stdio.h>
#include <lib/dns.h>

int main() {
    const char* buf = ...; // DNS packet data
    unsigned int len = ...; // Length of the DNS packet
    unsigned int pos = ...; // Current position in the DNS packet
    char out[256]; // Output buffer
    unsigned int outlen = 256; // Length of the output buffer

    unsigned int newpos = dns_packet_copy(buf, len, pos, out, outlen);

    if (newpos == 0) {
        fprintf(stderr, "Error: dns_packet_copy failed\n");
        return 1;
    }

    printf("Copied data: %.*s\n", newpos - pos, out);

    return 0;
}
.nef