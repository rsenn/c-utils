.TH lib/ihex/ihex_record_insert.c 3 "2023-04-10" "lib/ihex" "Manual Page"
.SH NAME
ihex_record_insert - Insert an IHEX record at a specific address
.SH SYNOPSIS
.I #include <lib/ihex.h>
.I ihex_record*
.I ihex_record_insert
.I (
.I ihex_file *ihf,
.I uint32 at,
.I uint8 len
.I )
.SH DESCRIPTION
The .B ihex_record_insert function inserts an IHEX record at a specific address.

The function takes three parameters:
.I ihf
The IHEX file structure.
.I at
The address to insert the record at.
.I len
The length of the record data.

The function returns a pointer to the inserted IHEX record on success, or NULL on error.

.SH EXAMPLE
The following example demonstrates how to use the .B ihex_record_insert function:

.I
.nf
#include <stdio.h>
#include <lib/ihex.h>

int main() {
  // Assume ihf is a valid IHEX file structure
  ihex_file ihf;

  // Initialize ihf

  uint32 at = 0x1000;
  uint8 len = 10;

  ihex_record* rec = ihex_record_insert(&ihf, at, len);

  if (rec == NULL) {
    perror("ihex_record_insert");
    return 1;
  }

  // Use the record

  return 0;
}
.!
