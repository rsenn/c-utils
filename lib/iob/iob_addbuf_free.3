.TH IO_ADDBUF_FREE 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
iob_addbuf_free \- Add data to an I/O batch buffer and free the buffer when done

.SH SYNOPSIS
.IB #include <lib/iob_internal.h>

.IB int
.IB iob_addbuf_free(
.IB io_batch* b,
.IB const void* buf,
.IB uint64 n
.IB );

.SH DESCRIPTION
The \fBiob_addbuf_free\fR function adds data from a buffer to an I/O batch buffer and frees the buffer once the data has been added. This function is useful when the buffer is no longer needed after being added to the batch.

The function takes the following parameters:

.IB b
Pointer to the I/O batch buffer.

.IB buf
Pointer to the buffer containing the data to be added.

.IB n
Number of bytes to add from the buffer.

The function returns 0 on success, or a negative value indicating an error.

The function is part of the \fBiob\fR library, which provides a framework for managing I/O operations in batch mode.

.SH EXAMPLES
The following example demonstrates how to use the \fBiob_addbuf_free\fR function to add data to an I/O batch buffer and free the buffer:

.nf
#include <stdio.h>
#include <lib/iob_internal.h>

int main() {
  io_batch batch;

  if (iob_init(&batch) != 0) {
    perror("iob_init");
    return 1;
  }

  char* data = malloc(14);
  if (data == NULL) {
    perror("malloc");
    iob_free(&batch);
    return 1;
  }

  strcpy(data, "Hello, World!");

  if (iob_addbuf_free(&batch, data, 14) != 0) {
    perror("iob_addbuf_free");
    free(data);
    iob_free(&batch);
    return 1;
  }

  if (iob_execute(&batch) != 0) {
    perror("iob_execute");
    iob_free(&batch);
    return 1;
  }

  printf("Data added to batch buffer and buffer freed\n");

  iob_free(&batch);
  return 0;
}
.nef