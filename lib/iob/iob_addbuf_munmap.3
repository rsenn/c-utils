.TH IO_ADDBUF_MUNMAP 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
iob_addbuf_munmap \- Add data to an I/O batch buffer and unmap the memory when done

.SH SYNOPSIS
.IB #include <lib/iob_internal.h>

.IB int
.IB iob_addbuf_munmap(
.IB io_batch* b,
.IB const void* buf,
.IB uint64 n
.IB );

.SH DESCRIPTION
The \fBiob_addbuf_munmap\fR function adds data from a memory-mapped buffer to an I/O batch buffer and unmaps the memory once the data has been added. This function is useful when the buffer is no longer needed after being added to the batch.

The function takes the following parameters:

.IB b
Pointer to the I/O batch buffer.

.IB buf
Pointer to the memory-mapped buffer containing the data to be added.

.IB n
Number of bytes to add from the buffer.

The function returns 0 on success, or a negative value indicating an error.

The function is part of the \fBiob\fR library, which provides a framework for managing I/O operations in batch mode.

.SH EXAMPLES
The following example demonstrates how to use the \fBiob_addbuf_munmap\fR function to add data from a memory-mapped buffer to an I/O batch buffer and unmap the memory:

.nf
#include <stdio.h>
#include <lib/iob_internal.h>
#include <sys/mman.h>
#include <fcntl.h>
#include <unistd.h>

int main() {
  io_batch batch;
  int fd = open("example.txt", O_RDONLY);
  if (fd < 0) {
    perror("open");
    return 1;
  }

  struct stat sb;
  if (fstat(fd, &sb) < 0) {
    perror("fstat");
    close(fd);
    return 1;
  }

  char* data = mmap(NULL, sb.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
  if (data == MAP_FAILED) {
    perror("mmap");
    close(fd);
    return 1;
  }

  io_batch_init(&batch);

  if (iob_addbuf_munmap(&batch, data, sb.st_size) != 0) {
    perror("iob_addbuf_munmap");
    munmap(data, sb.st_size);
    close(fd);
    return 1;
  }

  if (iob_execute(&batch) != 0) {
    perror("iob_execute");
    munmap(data, sb.st_size);
    close(fd);
    return 1;
  }

  printf("Data added to batch buffer and memory unmapped\n");

  munmap(data, sb.st_size);
  close(fd);
  return 0;
}
.nef