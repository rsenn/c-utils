.TH JSON_PARSE_OBJECT 3 "JSON Utility" "LIBJSON" "Library Functions"
.SH NAME
json_parse_object - Parse a JSON object
.SH SYNOPSIS
.B #include <lib/json/json.h>
.PP
.B int json_parse_object(jsonval* val, charbuf* b);
.SH DESCRIPTION
The
.B json_parse_object
function parses a JSON object from the specified
.IR charbuf
and stores the result in the specified
.IR jsonval
structure.
The function returns 1 on success, and 0 on failure.
.SH ARGUMENTS
.TP
.I val
A pointer to a
.B jsonval
structure to store the result.
.TP
.I b
A pointer to a
.B charbuf
structure containing the JSON object to parse.
.SH RETURN VALUE
The function returns 1 on success, and 0 on failure.
.SH EXAMPLE
The following example demonstrates how to use the
.B json_parse_object
function:
.PP
.B #include <lib/json/json.h>
.B #include <stdio.h>
.PP
.B int main() {
.B \tcharbuf b = CHARBUF_INIT;
.B \tcharbuf_append(&b, "{\"key1\":\"value1\", \"key2\":2}");
.B \tjsonval val;
.B \tint r = json_parse_object(&val, &b);
.B \tif (r) {
.B \t\tprintf("JSON object parsed successfully\n");
.B \t\tjson_free(&val);
.B \t}
.B \tcharbuf_free(&b);
.B \treturn 0;
.B }
.SH SEE ALSO
.B json_init,
.B json_free