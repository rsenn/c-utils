.TH JSON_PARSE_STRING 3 "JSON Utility" "LIBJSON" "Library Functions"
.SH NAME
json_parse_string - Parse a JSON string
.SH SYNOPSIS
.B #include <lib/json/json.h>
.PP
.B int json_parse_string(jsonval* val, charbuf* b);
.SH DESCRIPTION
The
.B json_parse_string
function parses a JSON string from the specified
.IR charbuf
and stores the result in the specified
.IR jsonval
structure.
The function returns 1 on success, and 0 on failure.
.SH ARGUMENTS
.TP
.I val
A pointer to a
.B jsonval
structure to store the result.
.TP
.I b
A pointer to a
.B charbuf
structure containing the JSON string to parse.
.SH RETURN VALUE
The function returns 1 on success, and 0 on failure.
.SH EXAMPLE
The following example demonstrates how to use the
.B json_parse_string
function:
.PP
.B #include <lib/json/json.h>
.B #include <stdio.h>
.PP
.B int main() {
.B \tcharbuf b = CHARBUF_INIT;
.B \tcharbuf_append(&b, "\"Hello, World!\"");
.B \tjsonval val;
.B \tint ret = json_parse_string(&val, &b);
.B \tif (ret) {
.B \t\tprintf("JSON string parsed successfully\n");
.B \t\tprintf("Parsed string: %s\n", val.stringv.s);
.B \t\tjson_free(&val);
.B \t}
.B \tcharbuf_free(&b);
.B \treturn 0;
.B }
.SH SEE ALSO
.B json_init,
.B json_free