.TH JSON_PROPERTY_SET_INT 3 "JSON Utility" "LIBJSON" "Library Functions"
.SH NAME
json_property_set_int - Set a JSON property by integer index
.SH SYNOPSIS
.B #include <lib/json/json.h>
.PP
.B jsonval* json_property_set_int(jsonval* obj, int64 index, jsonval value);
.SH DESCRIPTION
The
.B json_property_set_int
function sets the value of a property in a JSON object by integer index.
If the property does not exist, it is created.
.SH ARGUMENTS
.TP
.I obj
A pointer to a
.B jsonval
structure representing the JSON object.
.TP
.I index
An integer index representing the property to set.
.TP
.I value
A
.B jsonval
structure representing the value to set.
.SH RETURN VALUE
A pointer to the set property, or NULL if the operation failed.
.SH EXAMPLE
The following example demonstrates how to use the
.B json_property_set_int
function:
.PP
.B #include <lib/json/json.h>
.B #include <stdio.h>
.PP
.B int main() {
.B \tjsonval obj = json_array();
.B \tjsonval value = json_int(42);
.B \tjsonval* ret = json_property_set_int(&obj, 0, value);
.B \tif (ret) {
.B \t\tprintf("Property set successfully\n");
.B \t} else {
.B \t\tprintf("Property set failed\n");
.B \t}
.B \tjson_free(&obj);
.B \tjson_free(&value);
.B \treturn 0;
.B }
.SH SEE ALSO
.B json_init,
.B json_free,
.B json_array,
.B json_property_set_str