.TH OMF_GET_NAME 3 "OMF Format" "LIBOMF" "Library Functions"
.SH NAME
omf_get_name - Get a name from an OMF record
.SH SYNOPSIS
.B #include <lib/omf/omf.h>
.PP
.B range omf_get_name(omf_record* rec, size_t idx);
.SH DESCRIPTION
The
.B omf_get_name
function returns the name at the specified index in an OMF record.
The returned
.B range
structure contains the name data.
.SH ARGUMENTS
.TP
.I rec
A pointer to an
.B omf_record
structure representing the OMF record.
.TP
.I idx
The index of the name to retrieve.
.SH RETURN VALUE
A
.B range
structure containing the name data.
.SH EXAMPLE
The following example demonstrates how to use the
.B omf_get_name
function:
.PP
.B #include <lib/omf/omf.h>
.B #include <stdio.h>
.PP
.B int main() {
.B \tomf_file omf;
.B \tomf_record* rec = omf_read(&omf);
.B \trange name = omf_get_name(rec, 0);
.B \tprintf("Name: %.*s\n", (int)name.len, name.start);
.B \treturn 0;
.B }
.SH SEE ALSO
.B omf_init,
.B omf_read,
.B omf_record