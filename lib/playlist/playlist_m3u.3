.TH PLAYLIST_M3U 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
playlist_m3u, m3u_reader \- Read and parse M3U playlists

.SH SYNOPSIS
.IB #include <lib/playlist.h>
.IB #include <lib/buffer.h>
.IB #include <lib/scan.h>
.IB #include <lib/str.h>

.IB static int
.IB m3u_reader(playlist* pl);

.IB void
.IB playlist_m3u(playlist* pls, buffer* b);

.SH DESCRIPTION
The \fBplaylist_m3u\fR function sets up a playlist to read and parse M3U playlists. It initializes the playlist structure and sets the reader function to \fBm3u_reader\fR.

The \fBm3u_reader\fR function reads and parses lines from the playlist buffer. It handles different types of M3U tags, such as \fB#EXTM3U\fR, \fB#EXTINF\fR, and \fB#EXTVLCOPT\fR. When a valid entry is found, it calls the callback function provided in the playlist structure.

.SH ARGUMENTS
.TP
.IB pl
The pointer to the playlist structure to be initialized.
.TP
.IB pls
The pointer to the playlist structure.
.TP
.IB b
The pointer to the buffer containing the M3U playlist data.

.SH RETURN VALUES
.TP
.IB m3u_reader
Returns 0 on success, or -1 on error.

.SH EXAMPLES
The following example demonstrates how to use the \fBplaylist_m3u\fR function:

.nf
#include <stdio.h>
#include <lib/playlist.h>
#include <lib/buffer.h>
#include <lib/scan.h>
#include <lib/str.h>

void my_callback(playlist* pl, stralloc* title, stralloc* path, unsigned long length) {
    printf("Title: %.*s\n", title->len, title->s);
    printf("Path: %.*s\n", path->len, path->s);
    printf("Length: %lu\n", length);
}

int main() {
    playlist pl;
    buffer b;
    stralloc_init(&b.s);
    stralloc_append(&b.s, "#EXTM3U\n");
    stralloc_append(&b.s, "#EXTINF:120,Example Title\n");
    stralloc_append(&b.s, "example.mp3\n");

    playlist_init(&pl);
    playlist_m3u(&pl, &b);
    pl.callback = my_callback;
    playlist_read(&pl);

    return 0;
}
.nef

