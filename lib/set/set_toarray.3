.TH SET_TOARRAY 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
set_toarray \- Convert a set to an array

.SH SYNOPSIS
.IB #include <lib/set.h>
.IB #include <lib/str.h>

.IB char**
.IB set_toarray(const set_t* set);

.SH DESCRIPTION
The \fBset_toarray\fR function converts a set to an array. It takes one argument: the set to convert. The function returns a pointer to a new array containing all the elements of the set.

.SH ARGUMENTS
.TP
.IB set
The set to convert.

.SH RETURN VALUE
The function returns a pointer to a new array containing all the elements of the set.

.SH EXAMPLES
The following example demonstrates how to use the \fBset_toarray\fR function:

.nf
#include <stdio.h>
#include <lib/set.h>
#include <lib/str.h>

int main() {
    set_t set;
    set_init(&set);

    set_inserts(&set, "apple");
    set_inserts(&set, "banana");
    set_inserts(&set, "cherry");

    printf("Set: %u elements\n", set.len);

    char** array = set_toarray(&set);

    printf("Array: ");
    for(int i = 0; array[i]; ++i) {
        printf("%s ", array[i]);
    }
    printf("\n");

    set_free(&set);
    for(int i = 0; array[i]; ++i) {
        free(array[i]);
    }
    free(array);
    return 0;
}
.nef