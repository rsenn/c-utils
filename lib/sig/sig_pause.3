.TH SIG_PAUSE 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
sig_pause \- Suspend the execution of the calling thread until a signal is received

.SH SYNOPSIS
.IB #include <lib/sig.h>

.IB void
.IB sig_pause(void);

.SH DESCRIPTION
The \fBsig_pause\fR function suspends the execution of the calling thread until a signal is received. It takes no arguments.

.SH RETURN VALUE
The function does not return.

.SH EXAMPLES
The following example demonstrates how to use the \fBsig_pause\fR function:

.nf
#include <stdio.h>
#include <lib/sig.h>
#include <signal.h>

void handle_sigint(int signum) {
    printf("Caught SIGINT.\n");
}

int main() {
    struct sigaction sa;

    printf("Setting SIGINT to be handled...\n");

    sa.sa_handler = handle_sigint;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;

    int r = sigaction(SIGINT, &sa, NULL);

    if(r == 0)
        printf("SIGINT set to be handled successfully.\n");
    else
        printf("Failed to set SIGINT to be handled.\n");

    printf("Pausing execution...\n");

    sig_pause();

    printf("Execution resumed after signal received.\n");

    return 0;
}
.nef