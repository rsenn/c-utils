.TH SIG_SHIELD 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
sig_shield \- Block a set of signals

.SH SYNOPSIS
.IB #include <lib/sig.h>

.IB int
.IB sig_shield(void);

.SH DESCRIPTION
The \fBsig_shield\fR function blocks a set of signals, including SIGTERM, SIGQUIT, SIGABRT, SIGINT, SIGPIPE, and SIGHUP. It takes no arguments and returns 0 on success, -1 on failure.

.SH RETURN VALUE
The function returns 0 on success, and -1 on failure.

.SH EXAMPLES
The following example demonstrates how to use the \fBsig_shield\fR function:

.nf
#include <stdio.h>
#include <lib/sig.h>
#include <signal.h>

void handle_sigint(int signum) {
    printf("Caught SIGINT.\n");
}

int main() {
    struct sigaction sa;

    printf("Setting SIGINT to be handled...\n");

    sa.sa_handler = handle_sigint;
    sigemptyset(&sa.sa_mask);
    sa.sa_flags = 0;

    int r = sigaction(SIGINT, &sa, NULL);

    if(r == 0)
        printf("SIGINT set to be handled successfully.\n");
    else
        printf("Failed to set SIGINT to be handled.\n");

    printf("Shielding signals...\n");

    int ret = sig_shield();

    if(ret == 0)
        printf("Signals shielded successfully.\n");
    else
        printf("Failed to shield signals.\n");

    return 0;
}
.nef