.TH LIBSTR_STR_CATN 3 "2023-04-01" "libstr" "String Library"
.SH NAME
str_catn \- Concatenate two strings with a maximum length
.SH SYNOPSIS
.B #include <libstr.h>
.sp
.B size_t
.B str_catn(void* p1, const void* p2, size_t max);
.SH DESCRIPTION
The
.B str_catn
function concatenates two strings, with a maximum length. The
.B p1
argument is a pointer to the destination string.
The
.B p2
argument is a pointer to the source string.
The
.B max
argument is the maximum length of the destination string.
The function returns the number of characters copied to the destination string.
.SH EXAMPLE
The following example demonstrates how to use the
.B str_catn
function to concatenate two strings with a maximum length:
.nf
.B #include <libstr.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   char s1[100] = "hello";
.B   const char* s2 = " world";
.B   size_t result = str_catn(s1, s2, sizeof(s1));
.B   printf("Concatenated string: %s\n", s1);
.B   printf("Number of characters copied: %zu\n", result);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B str_init(3),
.B str_copys(3),
.B free(3)