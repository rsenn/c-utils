.TH LIBSTR_STR_FBINDB 3 "2023-04-01" "libstr" "String Library"
.SH NAME
str_findb \- Find the first occurrence of a substring within a string
.SH SYNOPSIS
.B #include <libstr.h>
.sp
.B size_t
.B str_findb(const char* s1, const char* x, size_t n);
.SH DESCRIPTION
The
.B str_findb
function finds the first occurrence of a substring within a string. The
.B s1
argument is a pointer to the string to be searched.
The
.B x
argument is a pointer to the substring to be searched for.
The
.B n
argument is the length of the substring to be searched for.
The function returns the starting index of the first occurrence of the substring within the string, or the length of the string if the substring is not found.
.SH EXAMPLE
The following example demonstrates how to use the
.B str_findb
function to find the first occurrence of a substring within a string:
.nf
.B #include <libstr.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* s = "hello world";
.B   const char* substring = "world";
.B   size_t len = 5;
.B   size_t result = str_findb(s, substring, len);
.B   if(result < str_len(s)) {
.B     printf("Substring found at index: %zu\n", result);
.B   } else {
.B     printf("Substring not found\n");
.B   }
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B str_init(3),
.B str_copys(3),
