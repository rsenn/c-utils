.TH BYTE_SCAN 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
byte_scan \- Scan a byte string and store results in a stralloc

.SH SYNOPSIS
.IB #include <lib/byte.h>
.IB #include <lib/stralloc.h>

.IB size_t
.IB byte_scan(const char* in, size_t in_len, stralloc* out, size_t (*scan_function)(), ...);

.SH DESCRIPTION
The \fBbyte_scan\fR function scans a byte string \fIin\fR of length \fIin_len\fR and stores the results in the stralloc \fIout\fR using the specified scan function. The scan function is provided by the caller and determines how to process each byte in the input string.

.SH PARAMETERS
.IB in
The input byte string to be scanned.

.IB in_len
The length of the input byte string.

.IB out
The stralloc where the results of the scan will be stored.

.IB scan_function
A pointer to the scan function to be used for processing each byte.

.SH RETURN VALUE
The \fBbyte_scan\fR function returns the number of characters added to the stralloc \fIout\fR on success, or 0 if an error occurred.

.SH EXAMPLES
The following example demonstrates how to use the \fBbyte_scan\fR function to scan a byte string and store the results in a stralloc:

.nf
#include <stdio.h>
#include <lib/byte.h>
#include <lib/stralloc.h>

// Example scan function
size_t scan_char(const char* in, char* out, void* arg1, void* arg2, void* arg3, void* arg4) {
    if (in[0] == 'a') {
        out[0] = 'A';
        return 1;
    }
    out[0] = in[0];
    return 1;
}

int main() {
    const char* input = "abcde";
    size_t input_len = 5;
    stralloc sa;

    stralloc_init(&sa);

    size_t result = byte_scan(input, input_len, &sa, scan_char, NULL, NULL, NULL, NULL);

    if (result > 0) {
        // Your code to use the results stored in sa here
        printf("Scanned string: %s\n", sa.s);
    } else {
        printf("Scan failed\n");
    }

    stralloc_done(&sa);

    return 0;
}
.nef