.TH STRALLOC_CASE_DIFF 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
stralloc_case_diff \- Compare two strallocs ignoring case

.SH SYNOPSIS
.IB #include <lib/byte.h>
.IB #include <lib/stralloc.h>

.IB int
.IB stralloc_case_diff(const stralloc* sa1, const stralloc* sa2);

.SH DESCRIPTION
The \fBstralloc_case_diff\fR function compares two strallocs \fIsa1\fR and \fIsa2\fR, ignoring case differences, and returns the result of the comparison.

.SH PARAMETERS
.IB sa1
The first stralloc to compare.

.IB sa2
The second stralloc to compare.

.SH RETURN VALUE
The \fBstralloc_case_diff\fR function returns 0 if the strallocs are equal, a negative value if \fIsa1\fR is less than \fIsa2\fR, and a positive value if \fIsa1\fR is greater than \fIsa2\fR.

.SH EXAMPLES
The following example demonstrates how to use the \fBstralloc_case_diff\fR function to compare two strallocs:

.nf
#include <stdio.h>
#include <lib/byte.h>
#include <lib/stralloc.h>

int main() {
    stralloc sa1;
    stralloc sa2;

    stralloc_init(&sa1);
    stralloc_init(&sa2);

    // Your code to initialize sa1 and sa2 here

    int result = stralloc_case_diff(&sa1, &sa2);

    if (result == 0) {
        printf("strallocs are equal\n");
    } else if (result < 0) {
        printf("sa1 is less than sa2\n");
    } else {
        printf("sa1 is greater than sa2\n");
    }

    stralloc_done(&sa1);
    stralloc_done(&sa2);

    return 0;
}
.nef