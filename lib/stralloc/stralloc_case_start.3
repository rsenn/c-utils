.TH STRALLOC_CASE_START 3 "15 Mar 2023" "CB" "Library Functions"

.SH NAME
stralloc_case_start \- Check if a stralloc starts with a specific prefix, ignoring case

.SH SYNOPSIS
.IB #include <lib/byte.h>
.IB #include <lib/stralloc.h>

.IB size_t
.IB stralloc_case_start(const stralloc* sa, const stralloc* prefix);

.SH DESCRIPTION
The \fBstralloc_case_start\fR function checks if the stralloc \fIsa\fR starts with the prefix \fIprefix\fR, ignoring case differences, and returns 1 if it does, or 0 if it does not.

.SH PARAMETERS
.IB sa
The stralloc to check.

.IB prefix
The prefix to check for.

.SH RETURN VALUE
The \fBstralloc_case_start\fR function returns 1 if the stralloc starts with the prefix, or 0 if it does not.

.SH EXAMPLES
The following example demonstrates how to use the \fBstralloc_case_start\fR function to check if a stralloc starts with a specific prefix:

.nf
#include <stdio.h>
#include <lib/byte.h>
#include <lib/stralloc.h>

int main() {
    stralloc sa;
    stralloc prefix;

    stralloc_init(&sa);
    stralloc_init(&prefix);

    // Your code to initialize sa and prefix here

    if (stralloc_case_start(&sa, &prefix)) {
        printf("sa starts with prefix\n");
    } else {
        printf("sa does not start with prefix\n");
    }

    stralloc_done(&sa);
    stralloc_done(&prefix);

    return 0;
}
.nef