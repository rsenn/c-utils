.TH LIBSTRARRAY_STRARRAY_PREPENDS 3 "2023-04-01" "libstrarray" "String Array Library"
.SH NAME
strarray_prepends \- Prepend a string to each element of a string array
.SH SYNOPSIS
.B #include <libstrarray.h>
.B #include <lib/str.h>
.B #include <lib/stralloc.h>
.sp
.B int
.B strarray_prepends(strarray* arr, const char* s);
.SH DESCRIPTION
The
.B strarray_prepends
function prepends a string to each element of a string array. The
.B arr
argument is a pointer to a
.B strarray
structure representing the array, and the
.B s
argument is a pointer to a constant character string representing the string to prepend.
The
.B strarray_prepends
function returns 1 if the operation is successful, or 0 if an error occurs.
.SH EXAMPLE
The following example demonstrates how to use the
.B strarray_prepends
function to prepend a string to each element of a string array:
.nf
.B #include <libstrarray.h>
.B #include <stdio.h>
.B #include <lib/str.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strarray arr;
.B   strarray_init(&arr);
.B   strarray_append(&arr, "Hello");
.B   strarray_append(&arr, "world");
.B   if(strarray_prepends(&arr, "foo")) {
.B     printf("Prepended string array: ");
.B     strarray_foreach(&arr, p) {
.B       printf("%s ", *p);
.B     }
.B     printf("\n");
.B   } else {
.B     printf("Error prepending string to array\n");
.B   }
.B   // Free the allocated memory
.B   strarray_done(&arr);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strarray_init(3),
.B strarray_append(3),
.B strarray_done(3),
.B strarray_foreach(3),
.B str_len(3),
.B stralloc_prepends(3)