.TH LIBSTRARRAY_STRARRAY_REMOVEPREFIXS 3 "2023-04-01" "libstrarray" "String Array Library"
.SH NAME
strarray_removeprefixs \- Remove a prefix from each element of a string array
.SH SYNOPSIS
.B #include <libstrarray.h>
.B #include <lib/str.h>
.B #include <lib/stralloc.h>
.B #include <lib/byte.h>
.sp
.B int
.B strarray_removeprefixs(strarray* arr, const char* s);
.SH DESCRIPTION
The
.B strarray_removeprefixs
function removes a prefix from each element of a string array. The
.B arr
argument is a pointer to a
.B strarray
structure representing the array, and the
.B s
argument is a pointer to a constant character string representing the prefix to remove.
The
.B strarray_removeprefixs
function removes the specified prefix from each string in the array, if it exists. If the string does not start with the specified prefix, it remains unchanged.
The
.B strarray_removeprefixs
function returns 1 if the operation is successful, or 0 if an error occurs.
.SH EXAMPLE
The following example demonstrates how to use the
.B strarray_removeprefixs
function to remove a prefix from each element of a string array:
.nf
.B #include <libstrarray.h>
.B #include <stdio.h>
.B #include <lib/str.h>
.B #include <lib/stralloc.h>
.B #include <lib/byte.h>
.sp
.B int main() {
.B   strarray arr;
.B   strarray_init(&arr);
.B   strarray_append(&arr, "Hello");
.B   strarray_append(&arr, "world");
.B   if(strarray_removeprefixs(&arr, "Hello")) {
.B     printf("String array: ");
.B     strarray_foreach(&arr, p) {
.B       printf("%s ", *p);
.B     }
.B     printf("\n");
.B   } else {
.B     printf("Error removing prefix from array\n");
.B   }
.B   // Free the allocated memory
.B   strarray_done(&arr);
.B   return 0;
.B }
.ne
.fi
