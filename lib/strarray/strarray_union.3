.TH LIBSTRARRAY_STRARRAY_UNION 3 "2023-04-01" "libstrarray" "String Array Library"
.SH NAME
strarray_union \- Compute the union of two string arrays
.SH SYNOPSIS
.B #include <libstrarray.h>
.B #include <lib/str.h>
.sp
.B void
.B strarray_union(const strarray* s1, const strarray* s2, strarray* out);
.SH DESCRIPTION
The
.B strarray_union
function computes the union of two string arrays. The
.B s1
argument is a pointer to a
.B strarray
structure representing the first input array, and the
.B s2
argument is a pointer to a
.B strarray
structure representing the second input array.
The
.B out
argument is a pointer to a
.B strarray
structure representing the output array.
The
.B strarray_union
function computes the union of the two input arrays, which is the set of all unique elements that appear in either of the arrays. The output array is resized to match the number of unique elements.
The
.B strarray_union
function returns nothing.
.SH EXAMPLE
The following example demonstrates how to use the
.B strarray_union
function to compute the union of two string arrays:
.nf
.B #include <libstrarray.h>
.B #include <stdio.h>
.B #include <lib/str.h>
.sp
.B int main() {
.B   strarray arr1, arr2, out;
.B   strarray_init(&arr1);
.B   strarray_init(&arr2);
.B   strarray_init(&out);
.B   strarray_append(&arr1, "hello");
.B   strarray_append(&arr1, "world");
.B   strarray_append(&arr2, "world");
.B   strarray_append(&arr2, "test");
.B   strarray_union(&arr1, &arr2, &out);
.B   printf("Union array: ");
.B   strarray_foreach(&out, p) {
.B     printf("%s ", *p);
.B   }
.B   printf("\n");
.B   // Free the allocated memory
.B   strarray_done(&arr1);
.B   strarray_done(&arr2);
.B   strarray_done(&out);
.B   for(size_t i = 0; i < strarray_size(&out); ++i) {
.B     free((char*)array_get((array*)out.a, sizeof(char*), i));
.B   }
.B   return 0;
.B }
.ne
.fi
