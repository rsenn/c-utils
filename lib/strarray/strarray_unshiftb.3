.TH LIBSTRARRAY_STRARRAY_UNSHIFTB 3 "2023-04-01" "libstrarray" "String Array Library"
.SH NAME
strarray_unshiftb \- Add a buffer as the first element of a string array
.SH SYNOPSIS
.B #include <libstrarray.h>
.B #include <lib/str.h>
.sp
.B int
.B strarray_unshiftb(strarray* arr, const char* b, size_t n);
.SH DESCRIPTION
The
.B strarray_unshiftb
function adds a buffer as the first element of a string array. The
.B arr
argument is a pointer to a
.B strarray
structure representing the input array.
The
.B b
argument is a pointer to a buffer that contains the string to be added.
The
.B n
argument is the size of the buffer.
The
.B strarray_unshiftb
function copies the contents of the buffer to a new string and appends it to the beginning of the input array. The input array is resized to accommodate the new element.
The
.B strarray_unshiftb
function returns 1 if the element was successfully added, or 0 if it failed.
.SH EXAMPLE
The following example demonstrates how to use the
.B strarray_unshiftb
function to add a buffer as the first element of a string array:
.nf
.B #include <libstrarray.h>
.B #include <stdio.h>
.B #include <lib/str.h>
.sp
.B int main() {
.B   strarray arr;
.B   strarray_init(&arr);
.B   const char* buffer = "hello";
.B   size_t size = strlen(buffer);
.B   if(strarray_unshiftb(&arr, buffer, size)) {
.B     printf("First element: %s\n", arr.a.a[0]);
.B   } else {
.B     printf("Failed to add element\n");
.B   }
.B   // Free the allocated memory
.B   strarray_done(&arr);
.B   for(size_t i = 0; i < strarray_size(&arr); ++i) {
.B     free((char*)array_get((array*)arr.a.a, sizeof(char*), i));
.B   }
.B   return 0;
.B }
.ne
.fi
