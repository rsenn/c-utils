.TH LIBSTRARRAY_STRARRAY_UNSHIFTN 3 "2023-04-01" "libstrarray" "String Array Library"
.SH NAME
strarray_unshiftn \- Add multiple elements as the first element of a string array
.SH SYNOPSIS
.B #include <libstrarray.h>
.sp
.B int
.B strarray_unshiftn(strarray* arr, const char* const* v, size_t n);
.SH DESCRIPTION
The
.B strarray_unshiftn
function adds multiple elements as the first element of a string array. The
.B arr
argument is a pointer to a
.B strarray
structure representing the input array.
The
.B v
argument is a pointer to a null-terminated array of strings that contain the elements to be added.
The
.B n
argument is the number of elements in the array.
The
.B strarray_unshiftn
function appends the elements to the beginning of the input array. The input array is resized to accommodate the new elements.
The
.B strarray_unshiftn
function returns 1 if the elements were successfully added, or 0 if it failed.
.SH EXAMPLE
The following example demonstrates how to use the
.B strarray_unshiftn
function to add multiple elements as the first element of a string array:
.nf
.B #include <libstrarray.h>
.B #include <stdio.h>
.B #include <lib/str.h>
.sp
.B int main() {
.B   strarray arr;
.B   strarray_init(&arr);
.B   const char* elements[] = {"hello", "world", "test"};
.B   size_t size = sizeof(elements) / sizeof(elements[0]) - 1;
.B   if(strarray_unshiftn(&arr, elements, size)) {
.B     printf("First elements: ");
.B     for(size_t i = 0; i < strarray_size(&arr); ++i) {
.B       printf("%s ", arr.a.a[i]);
.B     }
.B     printf("\n");
.B   } else {
.B     printf("Failed to add elements\n");
.B   }
.B   // Free the allocated memory
.B   strarray_done(&arr);
.B   for(size_t i = 0; i < strarray_size(&arr); ++i) {
.B     free((char*)array_get((array*)arr.a.a, sizeof(char*), i));
.B   }
.B   return 0;
.B }
.ne
.fi
