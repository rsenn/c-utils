.TH LIBSTRLIST_STRLIST_APPEND_SA 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_append_sa \- Append a string allocation to a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.B #include <lib/byte.h>
.B #include <lib/str.h>
.sp
.B int
.B strlist_append_sa(strlist* sl, const stralloc* sa);
.SH DESCRIPTION
The
.B strlist_append_sa
function appends a string allocation to a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input list.
The
.B sa
argument is a pointer to a
.B stralloc
structure representing the string to be appended.
The
.B strlist_append_sa
function copies the contents of the string allocation to a new string and appends it to the input list.
The
.B strlist_append_sa
function returns 1 if the string was successfully appended, or 0 if it failed.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_append_sa
function to append a string allocation to a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/byte.h>
.B #include <lib/str.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sa, "hello");
.B   if(strlist_append_sa(&sl, &sa)) {
.B     printf("First element: %s\n", sl.sa.s);
.B   } else {
.B     printf("Failed to append element\n");
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sa);
.B   stralloc_free(&sl.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
