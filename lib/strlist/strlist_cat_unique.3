.TH LIBSTRLIST_STRLIST_CAT_UNIQUE 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_cat_unique \- Append unique elements from a string list to another string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_cat_unique(strlist* sl, const strlist* l);
.SH DESCRIPTION
The
.B strlist_cat_unique
function appends unique elements from a string list to another string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input list.
The
.B l
argument is a pointer to a
.B strlist
structure representing the string list to be appended.
The
.B strlist_cat_unique
function returns the number of unique elements appended.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_cat_unique
function to append unique elements from a string list to another string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl, l;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&l.sa);
.B   stralloc_copys(&sl.sa, "hello,world,test");
.B   stralloc_copys(&l.sa, "hello,new,world,test");
.B   int ret = strlist_cat_unique(&sl, &l);
.B   if(ret > 0) {
.B     printf("Appended %d unique elements\n", ret);
.B   } else {
.B     printf("No unique elements to append\n");
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&l.sa);
.B   stralloc_free(&sl.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)