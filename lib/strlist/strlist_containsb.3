.TH LIBSTRLIST_STRLIST_CONTAINSB 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_containsb \- Check if a string list contains a specific string
.SH SYNOPSIS
.B #include <libstrlist.h>
.B #include <lib/byte.h>
.sp
.B int
.B strlist_containsb(const strlist* sl, const char* x, size_t len);
.SH DESCRIPTION
The
.B strlist_containsb
function checks if a string list contains a specific string. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input list.
The
.B x
argument is a pointer to the string to be checked.
The
.B len
argument is the length of the string to be checked.
The
.B strlist_containsb
function returns 1 if the string is found, or 0 otherwise.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_containsb
function to check if a string list contains a specific string:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/byte.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc_init(&sl.sa);
.B   stralloc_copys(&sl.sa, "hello,world,test");
.B   if(strlist_containsb(&sl, "world", 5)) {
.B     printf("List contains 'world'\n");
.B   } else {
.B     printf("List does not contain 'world'\n");
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)