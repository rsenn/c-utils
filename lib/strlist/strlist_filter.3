.TH LIBSTRLIST_STRLIST_FILTER 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_filter \- Filter string list based on a pattern
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B void
.B strlist_filter(const strlist* sl, strlist* matching, strlist* not_matching, const char* pattern);
.SH DESCRIPTION
The
.B strlist_filter
function filters a string list based on a pattern. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input list.
The
.B matching
argument is a pointer to a
.B strlist
structure where the elements that match the pattern will be stored.
The
.B not_matching
argument is a pointer to a
.B strlist
structure where the elements that do not match the pattern will be stored.
The
.B pattern
argument is a pointer to a
.B char
string representing the pattern to match against.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_filter
function to filter a string list based on a pattern:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl, matching, not_matching;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&matching.sa);
.B   stralloc_init(&not_matching.sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   strlist_filter(&sl, &matching, &not_matching, "a*");
.B   printf("Matching elements: %s\n", matching.sa.s);
.B   printf("Not matching elements: %s\n", not_matching.sa.s);
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&matching.sa);
.B   stralloc_free(&not_matching.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)