.TH LIBSTRLIST_STRLIST_INDEX_OF 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_index_of \- Find the index of a string within a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int64
.B strlist_index_of(strlist* sl, const char* str);
.SH DESCRIPTION
The
.B strlist_index_of
function finds the index of a string within a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B str
argument is a pointer to a
.B char
string representing the string to find.
.SH RETURN VALUE
The function returns the index of the string within the string list, or -1 if the string is not found.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_index_of
function to find the index of a string within a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc_init(&sl.sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   int64 index = strlist_index_of(&sl, "banana");
.B   if(index != -1)
.B     printf("String found at index: %ld\n", index);
.B   else
.B     printf("String not found\n");
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)