.TH LIBSTRLIST_STRLIST_INTERSECTION 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_intersection \- Find the intersection of two string lists
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B void
.B strlist_intersection(const strlist* s1, const strlist* s2, strlist* out);
.sp
.B void
.B strlist_sorted_intersection(const strlist* s1, const strlist* s2, strlist* out);
.SH DESCRIPTION
The
.B strlist_intersection
function finds the intersection of two string lists. The
.B s1
argument is a pointer to a
.B strlist
structure representing the first input string list.
The
.B s2
argument is a pointer to a
.B strlist
structure representing the second input string list.
The
.B out
argument is a pointer to a
.B strlist
structure where the resulting string list will be stored.
The
.B strlist_sorted_intersection
function finds the intersection of two sorted string lists. The
.B s1
argument is a pointer to a
.B strlist
structure representing the first sorted input string list.
The
.B s2
argument is a pointer to a
.B strlist
structure representing the second sorted input string list.
The
.B out
argument is a pointer to a
.B strlist
structure where the resulting string list will be stored.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_intersection
function to find the intersection of two string lists:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl1, sl2, result;
.B   stralloc_init(&sl1.sa);
.B   stralloc_init(&sl2.sa);
.B   stralloc_init(&result.sa);
.B   stralloc_copys(&sl1.sa, "apple,banana,cherry,date");
.B   stralloc_copys(&sl2.sa, "banana,date,grape");
.B   strlist_intersection(&sl1, &sl2, &result);
.B   printf("Intersection: %.*s\n", (int)stralloc_len(&result.sa), stralloc_data(&result.sa));
.B   // Free the allocated memory
.B   stralloc_free(&sl1.sa);
.B   stralloc_free(&sl2.sa);
.B   stralloc_free(&result.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)