.TH LIBSTRLIST_STRLIST_JOINQ 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_joinq \- Join elements of a string list with a delimiter and quote characters
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B void
.B strlist_joinq(const strlist* sl, stralloc* sa, char delim, char quote);
.SH DESCRIPTION
The
.B strlist_joinq
function joins the elements of a string list with a delimiter and quote characters. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B sa
argument is a pointer to a
.B stralloc
structure where the resulting string will be stored.
The
.B delim
argument is a
.B char
representing the delimiter to use between elements.
The
.B quote
argument is a
.B char
representing the quote character to use for elements that contain the delimiter.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_joinq
function to join elements of a string list with a delimiter and quote characters:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   strlist_joinq(&sl, &sa, ',', '"');
.B   printf("Joined: %.*s\n", (int)stralloc_len(&sa), stralloc_data(&sa));
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
