.TH LIBSTRLIST_STRLIST_MATCH 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_match \- Match a pattern against elements of a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B ssize_t
.B strlist_match(const strlist* sl, const char* pattern, int start);
.SH DESCRIPTION
The
.B strlist_match
function matches a pattern against elements of a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B pattern
argument is a pointer to a
.B char
string representing the pattern to match.
The
.B start
argument is an
.B int
representing the index at which to start matching the pattern in the string list.
The function returns the index of the first element that matches the pattern, or -1 if no element matches.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_match
function to match a pattern against elements of a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   ssize_t index = strlist_match(&sl, "b*n", 0);
.B   if(index != -1)
.B     printf("Matched at index: %zd\n", index);
.B   else
.B     printf("No match found\n");
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)