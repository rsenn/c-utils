.TH LIBSTRLIST_STRLIST_POP 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_pop \- Remove the last element from a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_pop(strlist* sl);
.SH DESCRIPTION
The
.B strlist_pop
function removes the last element from a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The function returns 1 if the last element was successfully removed, or 0 if the string list was empty.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_pop
function to remove the last element from a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   int result = strlist_pop(&sl);
.B   if(result)
.B     printf("Element removed\n");
.B   else
.B     printf("String list was empty\n");
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)