.TH LIBSTRLIST_STRLIST_POS 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_pos \- Get the position of a specific index in a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int64
.B strlist_pos(const strlist* sl, size_t index);
.SH DESCRIPTION
The
.B strlist_pos
function gets the position of a specific index in a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B index
argument is a
.B size_t
representing the index for which to get the position.
The function returns the position of the specified index, or -1 if the index is out of bounds.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_pos
function to get the position of a specific index in a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   int64 pos = strlist_pos(&sl, 1);
.B   if(pos != -1)
.B     printf("Position of index 1: %lld\n", pos);
.B   else
.B     printf("Index out of bounds\n");
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)