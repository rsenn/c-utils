.TH LIBSTRLIST_STRLIST_PREPENDB 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_prependb \- Prepend a binary string to a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_prependb(strlist* sl, const char* b, size_t n);
.SH DESCRIPTION
The
.B strlist_prependb
function prepends a binary string to a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B b
argument is a pointer to a
.B char
string representing the binary string to prepend.
The
.B n
argument is a
.B size_t
representing the length of the binary string.
The function returns 1 if the binary string was successfully prepended, or 0 if there was not enough space to allocate the new string.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_prependb
function to prepend a binary string to a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   const char* b = "new_element";
.B   size_t n = 11;
.B   int result = strlist_prependb(&sl, b, n);
.B   if(result)
.B     printf("Binary string prepended\n");
.B   else
.B     printf("Not enough space to prepend binary string\n");
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)