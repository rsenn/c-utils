.TH LIBSTRLIST_STRLIST_PUSH_TOKENS 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_push_tokens \- Push tokens from a string into a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B void
.B strlist_push_tokens(strlist* sl, const char* s, const char* delim);
.SH DESCRIPTION
The
.B strlist_push_tokens
function pushes tokens from a string into a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B s
argument is a pointer to a
.B char
string representing the input string.
The
.B delim
argument is a pointer to a
.B char
string representing the delimiter to use to split the input string into tokens.
The function does not return a value.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_push_tokens
function to push tokens from a string into a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   const char* delim = ",";
.B   strlist_push_tokens(&sl, &sa, delim);
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)