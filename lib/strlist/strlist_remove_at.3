.TH LIBSTRLIST_STRLIST_REMOVE_AT 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_remove_at \- Remove a string at a specified index from a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_remove_at(strlist* l, size_t n);
.SH DESCRIPTION
The
.B strlist_remove_at
function removes a string at a specified index from a string list. The
.B l
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B n
argument is the index of the string to remove.
The function returns 1 if the string was successfully removed, or 0 if the index is out of bounds.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_remove_at
function to remove a string at a specified index from a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   size_t n = 1;
.B   int result = strlist_remove_at(&sl, n);
.B   if(result) {
.B     printf("String at index %zu removed\n", n);
.B   } else {
.B     printf("Index %zu out of bounds\n", n);
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
