.TH LIBSTRLIST_STRLIST_REMOVEB 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_removeb \- Remove a substring from a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_removeb(strlist* l, const char* x, size_t n);
.SH DESCRIPTION
The
.B strlist_removeb
function removes a substring from a string list. The
.B l
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B x
argument is a pointer to a
.B char
string representing the substring to remove.
The
.B n
argument is the length of the substring to remove.
The function returns 1 if the substring was successfully removed, or 0 if the substring is not found.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_removeb
function to remove a substring from a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   const char* x = "banana";
.B   size_t n = 6;
.B   int result = strlist_removeb(&sl, x, n);
.B   if(result) {
.B     printf("Substring %.*s removed\n", (int)n, x);
.B   } else {
.B     printf("Substring %.*s not found\n", (int)n, x);
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
