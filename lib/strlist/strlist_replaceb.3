.TH LIBSTRLIST_STRLIST_REPLACEB 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_replaceb \- Replace a substring in a string list with another substring
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_replaceb(strlist* l, const char* x, size_t n, const char* y, size_t len);
.SH DESCRIPTION
The
.B strlist_replaceb
function replaces a substring in a string list with another substring. The
.B l
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B x
argument is a pointer to a
.B char
string representing the substring to be replaced.
The
.B n
argument is the length of the substring to be replaced.
The
.B y
argument is a pointer to a
.B char
string representing the new substring.
The
.B len
argument is the length of the new substring.
The function returns 1 if the substring was successfully replaced, or 0 if the substring is not found.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_replaceb
function to replace a substring in a string list with another substring:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   const char* x = "banana";
.B   size_t n = 6;
.B   const char* y = "kiwi";
.B   size_t len = 4;
.B   int result = strlist_replaceb(&sl, x, n, y, len);
.B   if(result) {
.B     printf("Substring %.*s replaced with %.*s\n", (int)n, x, (int)len, y);
.B   } else {
.B     printf("Substring %.*s not found\n", (int)n, x);
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
