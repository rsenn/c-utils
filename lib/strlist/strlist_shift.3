.TH LIBSTRLIST_STRLIST_SHIFT 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_shift \- Shift the first string in a string list to the caller
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_shift(strlist* sl, const char** strp);
.SH DESCRIPTION
The
.B strlist_shift
function shifts the first string in a string list to the caller. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B strp
argument is a pointer to a pointer to a
.B char
string that will be set to the shifted string.
The function returns 1 if the string was successfully shifted, or 0 if the string list is empty.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_shift
function to shift the first string in a string list to the caller:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   const char* str;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   int result = strlist_shift(&sl, &str);
.B   if(result) {
.B     printf("Shifted string: %s\n", str);
.B   } else {
.B     printf("String list is empty\n");
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   free((char*)str);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)