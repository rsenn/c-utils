.TH LIBSTRLIST_STRLIST_SHIFT_N 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_shift_n \- Shift the string at the specified index in a string list to the end of the list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_shift_n(strlist* sl, size_t i);
.SH DESCRIPTION
The
.B strlist_shift_n
function shifts the string at the specified index in a string list to the end of the list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B i
argument is the index of the string to be shifted.
The function returns 1 if the string was successfully shifted, or 0 if the index is out of bounds.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_shift_n
function to shift the string at the specified index in a string list to the end of the list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_init(&sa);
.B   stralloc_copys(&sl.sa, "apple,banana,cherry,date");
.B   size_t i = 1;
.B   int result = strlist_shift_n(&sl, i);
.B   if(result) {
.B     printf("String at index %zu shifted to the end of the list\n", i);
.B   } else {
.B     printf("Index %zu out of bounds\n", i);
.B   }
.B   // Print the contents of the string list
.B   for(size_t j = 0; j < sl.len; j++) {
.B     printf("%s\n", sl.sl[j]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   stralloc_free(&sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)