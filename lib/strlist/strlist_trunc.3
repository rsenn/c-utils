.TH LIBSTRLIST_STRLIST_TRUNC 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_trunc \- Truncate a string list to a specified number of items
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_trunc(strlist* l, size_t items);
.SH DESCRIPTION
The
.B strlist_trunc
function truncates a string list to a specified number of items. The
.B l
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B items
argument is the number of items to retain in the string list.
The function returns the number of items that were truncated.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_trunc
function to truncate a string list to a specified number of items:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist l;
.B   stralloc sa;
.B   stralloc_init(&l.sa);
.B   stralloc_copys(&l.sa, "apple,banana,cherry,date");
.B   int result = strlist_trunc(&l, 2);
.B   if(result) {
.B     printf("Truncated %d items\n", result);
.B   } else {
.B     printf("No items to truncate\n");
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < l.len; i++) {
.B     printf("%s\n", l.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&l.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)