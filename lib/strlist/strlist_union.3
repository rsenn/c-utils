.TH LIBSTRLIST_STRLIST_UNION 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_union \- Union two string lists
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B void
.B strlist_union(const strlist* s1, const strlist* s2, strlist* out);
.SH DESCRIPTION
The
.B strlist_union
function unions two string lists. The
.B s1
and
.B s2
arguments are pointers to
.B strlist
structures representing the input string lists.
The
.B out
argument is a pointer to a
.B strlist
structure representing the output string list.
The function adds all items from both string lists to the output string list, ensuring that each item appears only once.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_union
function to union two string lists:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist s1;
.B   strlist s2;
.B   strlist out;
.B   stralloc sa;
.B   stralloc_init(&s1.sa);
.B   stralloc_init(&s2.sa);
.B   stralloc_init(&out.sa);
.B   stralloc_copys(&s1.sa, "apple,banana,cherry");
.B   stralloc_copys(&s2.sa, "banana,date,grape");
.B   strlist_union(&s1, &s2, &out);
.B   // Print the contents of the output string list
.B   for(size_t i = 0; i < out.len; i++) {
.B     printf("%s\n", out.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&s1.sa);
.B   stralloc_free(&s2.sa);
.B   stralloc_free(&out.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)