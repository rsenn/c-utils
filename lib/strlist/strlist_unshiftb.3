.TH LIBSTRLIST_STRLIST_UNSHIFTB 3 "2023-04-01" "libstrlist" "String List Library"
.SH NAME
strlist_unshiftb \- Add a string to the beginning of a string list
.SH SYNOPSIS
.B #include <libstrlist.h>
.sp
.B int
.B strlist_unshiftb(strlist* sl, const char* x, size_t len);
.SH DESCRIPTION
The
.B strlist_unshiftb
function adds a string to the beginning of a string list. The
.B sl
argument is a pointer to a
.B strlist
structure representing the input string list.
The
.B x
argument is a pointer to the string to be added.
The
.B len
argument is the length of the string to be added.
The function returns 1 on success, and 0 on failure.
.SH EXAMPLE
The following example demonstrates how to use the
.B strlist_unshiftb
function to add a string to the beginning of a string list:
.nf
.B #include <libstrlist.h>
.B #include <stdio.h>
.B #include <lib/stralloc.h>
.sp
.B int main() {
.B   strlist sl;
.B   stralloc sa;
.B   stralloc_init(&sl.sa);
.B   stralloc_copys(&sl.sa, "banana,cherry");
.B   const char* x = "apple";
.B   size_t len = 5;
.B   int result = strlist_unshiftb(&sl, x, len);
.B   if(result) {
.B     printf("Added string to the beginning of the string list\n");
.B   } else {
.B     printf("Failed to add string to the beginning of the string list\n");
.B   }
.B   // Print the contents of the string list
.B   for(size_t i = 0; i < sl.len; i++) {
.B     printf("%s\n", sl.sl[i]);
.B   }
.B   // Free the allocated memory
.B   stralloc_free(&sl.sa);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B strlist_init(3),
.B stralloc_init(3),
.B stralloc_copys(3),
.B stralloc_free(3),
.B free(3)