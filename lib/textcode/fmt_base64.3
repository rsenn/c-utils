.TH LIBTEXTCODE_FMT_BASE64 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_base64 - Format a string in Base64 encoding
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_base64(char* dest, const char* src, size_t len);
.SH DESCRIPTION
The
.B fmt_base64
function formats a string in Base64 encoding. The
.B dest
argument is a pointer to the buffer to store the encoded string.
The
.B src
argument is a pointer to the string to encode.
The
.B len
argument is the length of the string to encode.
The function encodes the specified string in Base64 encoding and stores the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_base64
function to encode a string:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   size_t len = strlen(str);
.B   size_t encoded_len = ((len + 2) / 3) * 4;
.B   char* encoded = malloc(encoded_len + 1);
.B   if(encoded) {
.B     size_t written = fmt_base64(encoded, str, len);
.B     if(written != (size_t)-1) {
.B       printf("Encoded string: %s\n", encoded);
.B     } else {
.B       printf("Error encoding string\n");
.B     }
.B     free(encoded);
.B   }
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B textcode,
