.TH LIBTEXTCODE_FMT_FOLDWHITESPACE 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_foldwhitespace - Fold whitespace characters in a string
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_foldwhitespace(char* dest, const char* src, size_t len);
.SH DESCRIPTION
The
.B fmt_foldwhitespace
function folds whitespace characters in a string. The
.B dest
argument is a pointer to the buffer to store the folded string.
The
.B src
argument is a pointer to the string to fold.
The
.B len
argument is the length of the string to fold.
The function folds the specified string by replacing whitespace characters with an underscore character and stores the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_foldwhitespace
function to fold whitespace characters in a string:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   size_t len = strlen(str);
.B   size_t folded_len = len;
.B   char* folded = malloc(folded_len + 1);
.B   if(folded) {
.B     size_t written = fmt_foldwhitespace(folded, str, len);
.B     if(written != (size_t)-1) {
.B       printf("Folded string: %s\n", folded);
.B     } else {
.B       printf("Error folding string\n");
.B     }
.B     free(folded);
.B   }
.B   return 0;
.B }
.ne
.fi
