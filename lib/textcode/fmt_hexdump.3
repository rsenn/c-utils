.TH LIBTEXTCODE_FMT_HEXDUMP 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_hexdump - Format a string as a hexadecimal dump
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_hexdump(char* dest, const char* src, size_t len);
.SH DESCRIPTION
The
.B fmt_hexdump
function formats a string as a hexadecimal dump. The
.B dest
argument is a pointer to the buffer to store the formatted string.
The
.B src
argument is a pointer to the string to format.
The
.B len
argument is the length of the string to format.
The function formats the specified string as a hexadecimal dump and stores the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_hexdump
function to format a string as a hexadecimal dump:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   size_t len = strlen(str);
.B   size_t hexdump_len = len * 2;
.B   char* hexdump = malloc(hexdump_len + 1);
.B   if(hexdump) {
.B     size_t written = fmt_hexdump(hexdump, str, len);
.B     if(written != (size_t)-1) {
.B       printf("Hexdump: %s\n", hexdump);
.B     } else {
.B       printf("Error formatting string as hexadecimal dump\n");
.B     }
.B     free(hexdump);
.B   }
.B   return 0;
.B }
.ne
.fi
