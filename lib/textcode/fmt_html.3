.TH LIBTEXTCODE_FMT_HTML 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_html - Format a string for HTML output
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_html(char* dest, const char* src, size_t len);
.SH DESCRIPTION
The
.B fmt_html
function formats a string for HTML output. The
.B dest
argument is a pointer to the buffer to store the formatted string.
The
.B src
argument is a pointer to the string to format.
The
.B len
argument is the length of the string to format.
The function formats the specified string for HTML output by replacing special characters with their HTML entities and storing the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_html
function to format a string for HTML output:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   size_t len = strlen(str);
.B   size_t html_len = len * 2;
.B   char* html = malloc(html_len + 1);
.B   if(html) {
.B     size_t written = fmt_html(html, str, len);
.B     if(written != (size_t)-1) {
.B       printf("HTML: %s\n", html);
.B     } else {
.B       printf("Error formatting string for HTML output\n");
.B     }
.B     free(html);
.B   }
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B textcode,
