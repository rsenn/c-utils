.TH LIBTEXTCODE_FMT_HTML_TAGARG 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_html_tagarg - Format a string for HTML tag arguments
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_html_tagarg(char* dest, const char* src, size_t len);
.SH DESCRIPTION
The
.B fmt_html_tagarg
function formats a string for HTML tag arguments. The
.B dest
argument is a pointer to the buffer to store the formatted string.
The
.B src
argument is a pointer to the string to format.
The
.B len
argument is the length of the string to format.
The function formats the specified string for HTML tag arguments by replacing special characters with their HTML entities and storing the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_html_tagarg
function to format a string for HTML tag arguments:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   size_t len = strlen(str);
.B   size_t html_tagarg_len = len * 2;
.B   char* html_tagarg = malloc(html_tagarg_len + 1);
.B   if(html_tagarg) {
.B     size_t written = fmt_html_tagarg(html_tagarg, str, len);
.B     if(written != (size_t)-1) {
.B       printf("HTML tagarg: %s\n", html_tagarg);
.B     } else {
.B       printf("Error formatting string for HTML tag arguments\n");
.B     }
.B     free(html_tagarg);
.B   }
.B   return 0;
.B }
.ne
.fi
