.TH LIBTEXTCODE_FMT_LDAPESCAPE2 3 "2023-04-01" "libtextcode" "Text Encoding Library"
.SH NAME
fmt_ldapescape2 - Format a string for LDAP escaping
.SH SYNOPSIS
.B #include <libtextcode.h>
.sp
.B size_t
.B fmt_ldapescape2(char* dest, const char* src, size_t len, const char* escapeme);
.SH DESCRIPTION
The
.B fmt_ldapescape2
function formats a string for LDAP escaping. The
.B dest
argument is a pointer to the buffer to store the formatted string.
The
.B src
argument is a pointer to the string to format.
The
.B len
argument is the length of the string to format.
The
.B escapeme
argument is a string containing characters to be escaped.
The function formats the specified string for LDAP escaping by replacing special characters with their escaped versions and storing the result in the specified buffer.
The function returns the number of characters written to the buffer.
.SH EXAMPLE
The following example demonstrates how to use the
.B fmt_ldapescape2
function to format a string for LDAP escaping:
.nf
.B #include <libtextcode.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* str = "Hello, World!";
.B   const char* escapeme = ",\\";
.B   size_t ldapescape_len = strlen(str) * 2;
.B   char* ldapescape = malloc(ldapescape_len + 1);
.B   if(ldapescape) {
.B     size_t written = fmt_ldapescape2(ldapescape, str, strlen(str), escapeme);
.B     if(written != (size_t)-1) {
.B       printf("LDAP escape: %s\n", ldapescape);
.B     } else {
.B       printf("Error formatting string for LDAP escaping\n");
.B     }
.B     free(ldapescape);
.B   }
.B   return 0;
.B }
.ne
.fi
