.TH LIBTLS_TLS_INSTANCE_HANDSHAKE 3 "2023-04-01" "libtls" "TLS Library"
.SH NAME
tls_instance_handshake - Perform TLS handshake
.SH SYNOPSIS
.B #include <libtls.h>
.sp
.B int
.B tls_instance_handshake(tls_instance_t* i);
.SH DESCRIPTION
The
.B tls_instance_handshake
function performs the TLS handshake for a TLS instance.
The
.B i
argument is a pointer to the TLS instance.
The function returns 1 if the handshake is successful, or -1 if there is an error.
.SH EXAMPLE
The following example demonstrates how to use the
.B tls_instance_handshake
function to perform the TLS handshake for a TLS instance:
.nf
.B #include <libtls.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   tls_t* tls = ...; // Assume a valid TLS instance
.B   int ret = tls_instance_handshake(tls);
.B   if(ret == -1) {
.B     fprintf(stderr, "Error performing TLS handshake\n");
.B     return 1;
.B   }

.B   // Use the TLS instance

.B   return 0;
.B }
.ne
.fi
