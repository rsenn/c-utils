.TH LIBTLS_TLS_READ 3 "2023-04-01" "libtls" "TLS Library"
.SH NAME
tls_read - Read data from a TLS connection
.SH SYNOPSIS
.B #include <libtls.h>
.sp
.B ssize_t
.B tls_read(fd_type fd, void* data, size_t len);
.SH DESCRIPTION
The
.B tls_read
function reads data from a TLS connection.
The function takes a
.IR fd " "
and a
.IR data " "
and a
.IR len " "
as arguments.
The function returns the number of bytes read, or -1 on error.
.SH EXAMPLE
The following example demonstrates how to use the
.B tls_read
function to read data from a TLS connection:
.nf
.B #include <libtls.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   char buffer[1024];
.B   ssize_t bytes_read = tls_read(fd, buffer, sizeof(buffer));
.B   if(bytes_read < 0) {
.B     // Handle error
.B   }
.B   // Use buffer
.B   return 0;
.B }
.ne
.fi
