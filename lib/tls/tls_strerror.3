.TH LIBTLS_TLS_STRERROR 3 "2023-04-01" "libtls" "TLS Library"
.SH NAME
tls_strerror - Get TLS error string
.SH SYNOPSIS
.B #include <libtls.h>
.sp
.B const char*
.B tls_strerror(fd_type fd);
.SH DESCRIPTION
The
.B tls_strerror
function gets the TLS error string.
The function takes a
.IR fd " "
as an argument.
The function returns a pointer to the TLS error string.
.SH EXAMPLE
The following example demonstrates how to use the
.B tls_strerror
function to get the TLS error string:
.nf
.B #include <libtls.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   fd_type fd = ...;
.B   const char* errstr = tls_strerror(fd);
.B   if(errstr == NULL) {
.B     // Handle error
.B   }
.B   // Use errstr
.B   return 0;
.B }
.ne
.fi
