.TH LIBXML_XML_SCAN_COMMENT 3 "2023-04-01" "libxml" "XML Library"
.SH NAME
xml_scan_comment \- Scan for a comment
.SH SYNOPSIS
.B #include <lib/xml.h>
.B #include <lib/byte.h>
.sp
.B size_t
.B xml_scan_comment(const char* x, size_t len);
.SH DESCRIPTION
The
.B xml_scan_comment
function scans for a comment in the specified
.B x
string, which is of length
.B len.
The
.B xml_scan_comment
function takes a pointer to a constant character string representing the string and a size_t representing the length of the string.
The
.B xml_scan_comment
function returns the number of characters scanned.
.SH EXAMPLE
The following example demonstrates how to use the
.B xml_scan_comment
function to scan for a comment:
.nf
.B #include <lib/xml.h>
.B #include <lib/byte.h>
.B #include <stdio.h>
.sp
.B int main() {
.B   const char* x = "<!-- This is a comment -->";
.B   size_t len = strlen(x);
.B   size_t j = xml_scan_comment(x, len);
.B   printf("Comment length: %zu\n", j);
.B   return 0;
.B }
.ne
.fi
.SH SEE ALSO
.B xml_scan(3),
.B xml_scanns(3)